# Copy to .env and adjust. Every value has a working default for local
# evaluation; change at least the passwords and keys for anything shared.

# --- DefectDojo ---
# Official image tags from hub.docker.com/r/defectdojo
#DJANGO_VERSION=latest
#NGINX_VERSION=latest

# Admin account created on first boot. The exporter and the test app also use
# these credentials to obtain their API tokens.
#DD_ADMIN_USER=admin
#DD_ADMIN_PASSWORD=Def3ctDojo@Exporter!

# Ports published on the host.
#DD_PORT=8080
#DD_TLS_PORT=8443

# Secrets. Defaults match the official evaluation compose file; override them
# for any deployment that is not a throwaway.
#DD_SECRET_KEY=
#DD_CREDENTIAL_AES_256_KEY=
#DD_DATABASE_PASSWORD=defectdojo

# --- Exporter ---
# Port where the exporter's /metrics is published on the host.
#EXPORTER_PORT=9100

# Metric collection interval.
#EXPORTER_INTERVAL=1m

# Set to use a pre-created DefectDojo API token instead of the admin
# credentials (leave empty to let the exporter fetch its own token).
#DD_TOKEN=
